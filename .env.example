# ---- Local development (npm run dev) ----
# Copy to .env. Defaults match compose.dev.yaml.
DATABASE_URL=postgres://fwp:fwp@localhost:5432/fwp
APP_ORIGIN=http://localhost:5173
TRUST_PROXY=1
LOG_LEVEL=debug
MAIL_TRANSPORT=log

# ---- Local full stack (docker compose up) ----
# Port the web app is published on. If you change it, set APP_ORIGIN to match.
# PORT=8080
