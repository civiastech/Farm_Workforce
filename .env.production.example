# Production settings for compose.prod.yaml. Copy to .env on the server and fill in every value.
# Never commit the real file.

# Your domain, with DNS A/AAAA records pointing at this server. Caddy obtains the TLS certificate.
DOMAIN=farmworkforce.example.ng
# Email for Let's Encrypt expiry notices.
ACME_EMAIL=ops@example.ng

# Database password. Generate one with:  openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=change-me

# Transactional email (password resets, application updates).
# Any SMTP provider works, e.g. smtps://USER:PASS@smtp.example.com:465
MAIL_FROM=Farm Workforce <no-reply@farmworkforce.example.ng>
SMTP_URL=smtps://user:password@smtp.example.com:465

# SMS: sign-up and password-reset codes, and application updates to workers.
# Pick one provider. Register the sender ID with the provider first (it can take a few days).
SMS_TRANSPORT=termii
SMS_SENDER_ID=FarmWork
TERMII_API_KEY=your-termii-api-key
# TERMII_CHANNEL=dnd        # "dnd" reaches numbers on Do-Not-Disturb; needed for codes
#
# Or Africa's Talking:
# SMS_TRANSPORT=africastalking
# AT_USERNAME=your-username
# AT_API_KEY=your-api-key

# Off-site backups (see docs/DEPLOYMENT.md, "Backups and monitoring").
# BACKUP_REMOTE=offsite:fwp-backups
# BACKUP_REMOTE_DAYS=30
# BACKUP_HEARTBEAT_URL=https://hc-ping.com/your-check-id

LOG_LEVEL=info

# Optional: pull prebuilt images from GitHub Container Registry instead of building on the server.
# IMAGE_PREFIX=ghcr.io/your-org/farm-workforce-platform
# IMAGE_TAG=v1.0.0
